{
  "name": "adonsecommerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node bin/server.js",
    "start:ts": "node --loader ts-node/esm bin/server.js",
    "start:direct": "node start-ts.js",
    "build": "node ace build",
    "build:ts": "node build-ts.js",
    "start:prod": "npm run build:ts && node build/bin/server.js",
    "dev": "node ace serve --watch",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./app/providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js"
  },
  "dependencies": {
    "@adonisjs/auth": "^9.1.1",
    "@adonisjs/core": "^6.2.0",
    "@adonisjs/lucid": "^20.1.0",
    "@adonisjs/session": "^7.1.0",
    "@adonisjs/shield": "^8.1.0",
    "@adonisjs/static": "^1.1.0",
    "@adonisjs/vite": "^2.0.0",
    "edge.js": "^6.3.0",
    "luxon": "^3.4.4",
    "mysql2": "^3.9.1",
    "reflect-metadata": "^0.2.1",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.1.0",
    "@adonisjs/eslint-config": "^1.2.0",
    "@adonisjs/prettier-config": "^1.2.0",
    "@adonisjs/tsconfig": "^1.2.0",
    "@japa/assert": "^2.1.0",
    "@japa/plugin-adonisjs": "^3.0.0",
    "@japa/runner": "^3.1.1",
    "@swc/core": "^1.3.102",
    "@types/luxon": "^3.3.7",
    "@types/node": "^20.10.6",
    "eslint": "^8.56.0",
    "pino-pretty": "^10.3.1",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  },
  "eslintConfig": {
    "extends": "@adonisjs/eslint-config/app"
  },
  "prettier": "@adonisjs/prettier-config"
}
