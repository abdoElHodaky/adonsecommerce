@layout('layouts/main')

@set('title', 'Reset Password - MultiMarket')

@section('content')
  <div class="max-w-md mx-auto bg-white rounded-lg shadow-md overflow-hidden">
    <div class="py-4 px-6 bg-indigo-600 text-white text-center">
      <h2 class="text-2xl font-bold">Reset Password</h2>
    </div>
    
    <form action="{{ route('auth.resetPassword') }}" method="POST" class="py-6 px-8">
      {{ csrfField() }}
      
      <input type="hidden" name="token" value="{{ token }}">
      <input type="hidden" name="email" value="{{ email }}">
      
      <div class="mb-4">
        <label for="password" class="block text-gray-700 text-sm font-bold mb-2">New Password</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
          required
        >
        @if(flashMessages.has('errors.password'))
          <p class="text-red-500 text-xs mt-1">{{ flashMessages.get('errors.password') }}</p>
        @end
      </div>
      
      <div class="mb-6">
        <label for="passwordConfirmation" class="block text-gray-700 text-sm font-bold mb-2">Confirm New Password</label>
        <input 
          type="password" 
          id="passwordConfirmation" 
          name="passwordConfirmation" 
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
          required
        >
        @if(flashMessages.has('errors.passwordConfirmation'))
          <p class="text-red-500 text-xs mt-1">{{ flashMessages.get('errors.passwordConfirmation') }}</p>
        @end
      </div>
      
      <div class="mb-6">
        <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
          Reset Password
        </button>
      </div>
      
      <div class="text-center">
        <p class="text-sm text-gray-600">
          Remember your password? 
          <a href="{{ route('auth.loginForm') }}" class="text-indigo-600 hover:text-indigo-800 font-semibold">
            Back to Login
          </a>
        </p>
      </div>
    </form>
  </div>
