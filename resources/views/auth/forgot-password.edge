  <div class="max-w-md mx-auto bg-white rounded-lg shadow-md overflow-hidden">
    <div class="py-4 px-6 bg-indigo-600 text-white text-center">
      <h2 class="text-2xl font-bold">Forgot Password</h2>
    </div>
    
    <form action="{{ route('auth.sendResetLink') }}" method="POST" class="py-6 px-8">
      {{ csrfField() }}
      
      <div class="mb-4">
        <p class="text-gray-600 mb-4">
          Enter your email address and we'll send you a link to reset your password.
        </p>
        
        <label for="email" class="block text-gray-700 text-sm font-bold mb-2">Email Address</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          value="{{ flashMessages.get('email') || '' }}"
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
          required
        >
        @if(flashMessages.has('errors.email'))
          <p class="text-red-500 text-xs mt-1">{{ flashMessages.get('errors.email') }}</p>
        @end
      </div>
      
      <div class="mb-6">
        <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
          Send Reset Link
        </button>
      </div>
      
      <div class="text-center">
        <p class="text-sm text-gray-600">
          Remember your password? 
          <a href="{{ route('auth.loginForm') }}" class="text-indigo-600 hover:text-indigo-800 font-semibold">
