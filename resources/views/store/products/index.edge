@layout('layouts/main')

@set('title', 'Shop Products - MultiMarket')

@section('content')
  <div class="flex flex-col md:flex-row gap-8">
    <!-- Sidebar Filters -->
    <div class="md:w-1/4 bg-white p-4 rounded-lg shadow-md h-fit">
      <h3 class="text-lg font-semibold mb-4">Filters</h3>
      
      <form action="{{ route('store.products') }}" method="GET">
        <!-- Categories -->
        <div class="mb-6">
          <h4 class="font-medium mb-2">Categories</h4>
          <div class="space-y-2">
            @each(category in categories)
              <div class="flex items-center">
                <input 
                  type="checkbox" 
                  id="category-{{ category.id }}" 
                  name="categories[]" 
                  value="{{ category.id }}"
                  class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded"
                  {{ request.qs().categories && request.qs().categories.includes(category.id.toString()) ? 'checked' : '' }}
                >
                <label for="category-{{ category.id }}" class="ml-2 text-sm text-gray-700">
                  {{ category.name }}
                </label>
              </div>
            @endeach
          </div>
        </div>
        
        <!-- Price Range -->
        <div class="mb-6">
          <h4 class="font-medium mb-2">Price Range</h4>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label for="min_price" class="block text-xs text-gray-500 mb-1">Min</label>
              <input 
                type="number" 
                id="min_price" 
                name="min_price" 
                value="{{ request.qs().min_price || '' }}"
                min="0" 
                placeholder="Min"
                class="w-full px-2 py-1 text-sm border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-indigo-500"
              >
            </div>
            <div>
              <label for="max_price" class="block text-xs text-gray-500 mb-1">Max</label>
              <input 
                type="number" 
                id="max_price" 
                name="max_price" 
                value="{{ request.qs().max_price || '' }}"
                min="0" 
                placeholder="Max"
                class="w-full px-2 py-1 text-sm border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-indigo-500"
              >
            </div>
          </div>
        </div>
        
        <!-- Merchants -->
        <div class="mb-6">
          <h4 class="font-medium mb-2">Merchants</h4>
          <div class="space-y-2 max-h-40 overflow-y-auto">
            @each(merchant in merchants)
              <div class="flex items-center">
                <input 
                  type="checkbox" 
                  id="merchant-{{ merchant.id }}" 
                  name="merchants[]" 
                  value="{{ merchant.id }}"
                  class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded"
                  {{ request.qs().merchants && request.qs().merchants.includes(merchant.id.toString()) ? 'checked' : '' }}
                >
                <label for="merchant-{{ merchant.id }}" class="ml-2 text-sm text-gray-700">
                  {{ merchant.storeName }}
                </label>
              </div>
            @endeach
          </div>
        </div>
        
        <!-- Sort By -->
        <div class="mb-6">
          <h4 class="font-medium mb-2">Sort By</h4>
          <select 
            name="sort" 
            class="w-full px-3 py-2 text-sm border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-indigo-500"
          >
            <option value="newest" {{ request.qs().sort === 'newest' ? 'selected' : '' }}>Newest</option>
            <option value="price_low" {{ request.qs().sort === 'price_low' ? 'selected' : '' }}>Price: Low to High</option>
            <option value="price_high" {{ request.qs().sort === 'price_high' ? 'selected' : '' }}>Price: High to Low</option>
            <option value="popular" {{ request.qs().sort === 'popular' ? 'selected' : '' }}>Most Popular</option>
          </select>
        </div>
        
        <div class="flex space-x-2">
          <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded text-sm flex-grow">
            Apply Filters
          </button>
          
          <a href="{{ route('store.products') }}" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-2 rounded text-sm">
            Reset
          </a>
        </div>
      </form>
    </div>
    
    <!-- Product Grid -->
    <div class="md:w-3/4">
      <!-- Search Results Info -->
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6">
        <h1 class="text-2xl font-bold">
          @if(request.qs().query)
            Search Results for "{{ request.qs().query }}"
          @elseif(category)
            {{ category.name }}
          @elseif(merchant)
            Products by {{ merchant.storeName }}
          @else
            All Products
          @endif
        </h1>
        
        <p class="text-gray-600 text-sm">
          Showing {{ products.length }} of {{ totalProducts }} products
        </p>
      </div>
      
      @if(products.length > 0)
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          @each(product in products)
            <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
              <a href="{{ route('store.productDetail', { slug: product.slug }) }}">
                <div class="h-48 bg-gray-200">
                  @if(product.images && product.images.length > 0)
                    <img src="{{ product.images[0].path }}" alt="{{ product.name }}" class="h-full w-full object-cover">
                  @else
                    <div class="h-full w-full flex items-center justify-center">
                      <i class="fas fa-image text-4xl text-gray-400"></i>
                    </div>
                  @endif
                </div>
              </a>
              
              <div class="p-4">
                <a href="{{ route('store.merchantDetail', { slug: product.merchant.slug }) }}" class="text-sm text-indigo-600 hover:text-indigo-800">
                  {{ product.merchant.storeName }}
                </a>
                
                <a href="{{ route('store.productDetail', { slug: product.slug }) }}" class="block mt-2 text-lg font-semibold hover:text-indigo-600">
                  {{ product.name }}
                </a>
                
                <div class="mt-2 flex items-center">
                  <span class="text-gray-900 font-bold">${{ product.price.toFixed(2) }}</span>
                  @if(product.compareAtPrice)
                    <span class="ml-2 text-gray-500 line-through text-sm">${{ product.compareAtPrice.toFixed(2) }}</span>
                    <span class="ml-2 text-green-600 text-sm">
                      {{ Math.round((1 - product.price / product.compareAtPrice) * 100) }}% off
                    </span>
                  @endif
                </div>
                
                <div class="mt-4 flex justify-between items-center">
                  <form action="{{ route('cart.add') }}" method="POST">
                    {{ csrfField() }}
                    <input type="hidden" name="product_id" value="{{ product.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm">
                      Add to Cart
                    </button>
                  </form>
                  
                  <button class="text-gray-500 hover:text-red-500">
                    <i class="far fa-heart"></i>
                  </button>
                </div>
              </div>
            </div>
          @endeach
        </div>
        
        <!-- Pagination -->
        @if(totalPages > 1)
          <div class="mt-8 flex justify-center">
            <div class="flex space-x-1">
              @if(page > 1)
                <a href="{{ route('store.products') }}?{{ new URLSearchParams({...request.qs(), page: page - 1}).toString() }}" class="px-4 py-2 bg-white border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50">
                  Previous
                </a>
              @endif
              
              @each(pageNum in Array.from({ length: totalPages }, (_, i) => i + 1))
                <a 
                  href="{{ route('store.products') }}?{{ new URLSearchParams({...request.qs(), page: pageNum}).toString() }}" 
                  class="px-4 py-2 {{ pageNum === page ? 'bg-indigo-600 text-white' : 'bg-white text-gray-700 hover:bg-gray-50' }} border border-gray-300 rounded-md"
                >
                  {{ pageNum }}
                </a>
              @endeach
              
              @if(page < totalPages)
                <a href="{{ route('store.products') }}?{{ new URLSearchParams({...request.qs(), page: page + 1}).toString() }}" class="px-4 py-2 bg-white border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50">
                  Next
                </a>
              @endif
            </div>
          </div>
        @endif
      @else
        <div class="bg-white rounded-lg shadow-md p-8 text-center">
          <i class="fas fa-search text-4xl text-gray-400 mb-4"></i>
          <h3 class="text-xl font-semibold mb-2">No Products Found</h3>
          <p class="text-gray-600 mb-4">
            We couldn't find any products matching your criteria.
          </p>
          <a href="{{ route('store.products') }}" class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2 rounded-lg">
            View All Products
          </a>
        </div>
      @endif
    </div>
  </div>
@endsection

