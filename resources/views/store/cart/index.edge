                      </div>
                      
                      <div class="flex-1 flex items-end justify-between text-sm">
                        <!-- Quantity Selector -->
                        <div class="flex items-center">
                          <span class="text-gray-500 mr-3">Qty</span>
                          <div class="custom-number-input h-8 w-24">
                            <div class="flex flex-row h-8 w-full rounded-lg relative bg-transparent">
                              <form action="{{ route('cart.update') }}" method="POST" class="flex">
                                {{ csrfField() }}
                                <input type="hidden" name="item_id" value="{{ item.id }}">
                                <button 
                                  type="submit" 
                                  name="quantity" 
                                  value="{{ item.quantity - 1 }}" 
                                  class="bg-gray-200 text-gray-600 hover:text-gray-700 hover:bg-gray-300 h-full w-8 rounded-l cursor-pointer outline-none"
                                  {{ item.quantity <= 1 ? 'disabled' : '' }}
                                >
                                  <span class="m-auto text-sm font-thin">−</span>
                                </button>
                                <input 
                                  type="number" 
                                  class="outline-none focus:outline-none text-center w-full bg-gray-100 font-semibold text-sm hover:text-black focus:text-black md:text-base cursor-default flex items-center text-gray-700" 
                                  name="quantity"
                                  value="{{ item.quantity }}"
                                  min="1" 
                                  max="{{ item.product.quantity }}"
                                  readonly
                                >
                                <button 
                                  type="submit" 
                                  name="quantity" 
                                  value="{{ item.quantity + 1 }}" 
                                  class="bg-gray-200 text-gray-600 hover:text-gray-700 hover:bg-gray-300 h-full w-8 rounded-r cursor-pointer"
                                  {{ item.quantity >= item.product.quantity ? 'disabled' : '' }}
                                >
                                  <span class="m-auto text-sm font-thin">+</span>
                                </button>
                              </form>
                            </div>
                          </div>
                        </div>
                        
                        <!-- Remove Button -->
                        <div class="flex">
                          <form action="{{ route('cart.remove') }}" method="POST">
                            {{ csrfField() }}
                            <input type="hidden" name="item_id" value="{{ item.id }}">
                            <button type="submit" class="font-medium text-indigo-600 hover:text-indigo-500">
                              Remove
                            </button>
                          </form>
                        </div>
                      </div>
