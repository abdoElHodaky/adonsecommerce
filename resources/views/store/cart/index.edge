                            <a href="{{ route('store.productDetail', { slug: item.product.slug }) }}">
                              {{ item.product.name }}
                            </a>
                          </h3>
                          <p class="ml-4">${{ (item.price * item.quantity).toFixed(2) }}</p>
                        </div>
                        <p class="mt-1 text-sm text-gray-500">
