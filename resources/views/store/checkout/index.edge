          <!-- Order Items -->
          <div class="mb-6">
            <h3 class="text-sm font-medium text-gray-700 mb-3">Items ({{ cart.items.length }})</h3>
            
            <div class="space-y-4 max-h-60 overflow-y-auto">
              @each(item in cart.items)
                <div class="flex items-start">
                  <div class="flex-shrink-0 w-16 h-16 border border-gray-200 rounded-md overflow-hidden">
                    @if(item.product.images && item.product.images.length > 0)
                      <img src="{{ item.product.images[0].path }}" alt="{{ item.product.name }}" class="w-full h-full object-cover">
                    @else
                      <div class="w-full h-full flex items-center justify-center bg-gray-100">
                        <i class="fas fa-image text-xl text-gray-400"></i>
                      </div>
                    @end
                  </div>
                  
                  <div class="ml-3 flex-1">
                    <h4 class="text-sm font-medium text-gray-900">{{ item.product.name }}</h4>
                    <p class="text-xs text-gray-500">
                      Qty: {{ item.quantity }}
                      @if(item.options)
                        <span class="ml-1">
                          @each((value, key) in item.options)
                            <span class="mr-1">{{ key }}: {{ value }}</span>
                          @end
                        </span>
                      @end
                    </p>
                  </div>
                  
                  <div class="text-sm font-medium text-gray-900">
                    ${{ (item.price * item.quantity).toFixed(2) }}
                  </div>
                </div>
              @end
            </div>
          </div>
          
          <!-- Price Summary -->
          <div class="space-y-3 border-t border-gray-200 pt-4">
            <div class="flex justify-between">
              <span class="text-gray-600">Subtotal</span>
              <span class="text-gray-900 font-medium">${{ cart.subtotal.toFixed(2) }}</span>
            </div>
            
            <div class="flex justify-between">
              <span class="text-gray-600">Shipping</span>
              <span class="text-gray-900 font-medium">${{ cart.shipping.toFixed(2) }}</span>
            </div>
            
            <div class="flex justify-between">
              <span class="text-gray-600">Tax</span>
              <span class="text-gray-900 font-medium">${{ cart.tax.toFixed(2) }}</span>
            </div>
            
            @if(cart.discount > 0)
              <div class="flex justify-between text-green-600">
                <span>Discount</span>
                <span>-${{ cart.discount.toFixed(2) }}</span>
              </div>
            @end
            
            <div class="border-t border-gray-200 pt-3 flex justify-between font-semibold">
              <span>Total</span>
              <span>${{ cart.total.toFixed(2) }}</span>
            </div>
          </div>
          
          <!-- Coupon Applied -->
          @if(cart.couponCode)
            <div class="mt-4 bg-green-50 text-green-700 px-3 py-2 rounded-md text-sm flex items-center">
              <i class="fas fa-check-circle mr-2"></i>
              <span>Coupon "{{ cart.couponCode }}" applied</span>
            </div>
