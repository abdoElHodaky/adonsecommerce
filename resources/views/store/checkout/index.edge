@section('scripts')
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sameAsShippingCheckbox = document.getElementById('same-as-shipping');
    const billingForm = document.getElementById('billing-form');
    
    sameAsShippingCheckbox.addEventListener('change', function() {
      if (this.checked) {
        billingForm.classList.add('hidden');
      } else {
        billingForm.classList.remove('hidden');
      }
    });
    
    const paymentCardRadio = document.getElementById('payment-card');
    const paymentPaypalRadio = document.getElementById('payment-paypal');
    const cardPaymentForm = document.getElementById('card-payment-form');
    
    paymentCardRadio.addEventListener('change', function() {
      if (this.checked) {
        cardPaymentForm.classList.remove('hidden');
      }
    });
    
    paymentPaypalRadio.addEventListener('change', function() {
      if (this.checked) {
        cardPaymentForm.classList.add('hidden');
      }
    });
  });
</script>
@end

