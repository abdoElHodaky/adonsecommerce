{{-- 
  Helper Functions for Edge Templates
  
  This file contains reusable helper functions that can be used across templates.
  Import these functions in your templates using @let directives.
--}}

{{-- Format currency with proper decimal places and currency symbol --}}
@let(formatCurrency = (amount, currency = 'USD') => {
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: currency
  }).format(amount)
})

{{-- Format date in a human-readable format --}}
@let(formatDate = (dateString, format = 'medium') => {
  const date = new Date(dateString)
  
  if (format === 'relative') {
    const now = new Date()
    const diffMs = now - date
    const diffSec = Math.floor(diffMs / 1000)
    const diffMin = Math.floor(diffSec / 60)
    const diffHour = Math.floor(diffMin / 60)
    const diffDay = Math.floor(diffHour / 24)

    if (diffSec < 60) {
      return 'just now'
    } else if (diffMin < 60) {
      return `${diffMin}m ago`
    } else if (diffHour < 24) {
      return `${diffHour}h ago`
    } else if (diffDay < 7) {
      return `${diffDay}d ago`
    }
  }
  
  // Default to standard date format
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: format === 'short' ? 'short' : 'long',
    day: 'numeric'
  })
})

{{-- Calculate discount percentage --}}
@let(calculateDiscount = (originalPrice, salePrice) => {
  if (!originalPrice || !salePrice || originalPrice <= 0) return 0
  return Math.round((1 - salePrice / originalPrice) * 100)
})

{{-- Truncate text with ellipsis --}}
@let(truncate = (text, length = 100) => {
  if (!text) return ''
  return text.length > length ? text.substring(0, length) + '...' : text
})

{{-- Get current year for copyright notices --}}
@let(currentYear = () => new Date().getFullYear())

