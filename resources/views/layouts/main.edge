<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title || 'Multi-Merchant E-commerce' }}</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Alpine.js -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  
  <!-- Custom Styles -->
  <style>
    [x-cloak] { display: none !important; }
  </style>
  
  @!section('styles')
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">
  <!-- Header -->
  <header class="bg-white shadow-sm">
    <div class="container mx-auto px-4 py-4">
      <div class="flex items-center justify-between">
        <!-- Logo -->
        <div class="flex items-center">
          <a href="/" class="text-2xl font-bold text-indigo-600">
            <span class="text-gray-800">Multi</span>Market
          </a>
        </div>
        
        <!-- Search Bar (Medium screens and up) -->
        <div class="hidden md:flex flex-1 mx-8">
          <form action="/store" method="GET" class="w-full max-w-xl">
            <div class="relative">
              <input 
                type="text" 
                name="query" 
                placeholder="Search for products..." 
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
              >
              <button type="submit" class="absolute right-2 top-2 text-gray-500">
                <i class="fas fa-search"></i>
              </button>
            </div>
          </form>
        </div>
        
        <!-- Navigation -->
        <nav class="flex items-center space-x-6">
          <!-- Cart -->
          <a href="/store/cart" class="text-gray-700 hover:text-indigo-600 relative">
            <i class="fas fa-shopping-cart text-xl"></i>
            <span class="absolute -top-2 -right-2 bg-indigo-600 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">
              {{ cart ? cart.items.length : 0 }}
            </span>
          </a>
          
          <!-- User Menu -->
          <div x-data="{ open: false }" class="relative">
            <button @click="open = !open" class="flex items-center text-gray-700 hover:text-indigo-600">
              @if(auth.isAuthenticated)
                <span class="mr-2">{{ auth.user.firstName }}</span>
                <i class="fas fa-user-circle text-xl"></i>
              @else
                <i class="fas fa-user-circle text-xl"></i>
              @endif
            </button>
            
            <div x-cloak x-show="open" @click.away="open = false" class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-10">
              @if(auth.isAuthenticated)
                @if(auth.user.userType === 'admin')
                  <a href="/admin/dashboard" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-500 hover:text-white">
                    Admin Dashboard
                  </a>
                @elseif(auth.user.userType === 'merchant')
                  <a href="/merchant/dashboard" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-500 hover:text-white">
                    Merchant Dashboard
                  </a>
                @else
                  <a href="/customer/dashboard" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-500 hover:text-white">
                    My Account
                  </a>
                @endif
                
                <a href="/customer/orders" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-500 hover:text-white">
                  My Orders
                </a>
                
                <a href="/auth/logout" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-500 hover:text-white">
                  Logout
                </a>
              @else
                <a href="/auth/login" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-500 hover:text-white">
                  Login
                </a>
                
                <a href="/auth/register" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-500 hover:text-white">
                  Register
                </a>
              @endif
            </div>
          </div>
        </nav>
      </div>
      
      <!-- Mobile Search (Small screens only) -->
      <div class="mt-4 md:hidden">
        <form action="/store" method="GET">
          <div class="relative">
            <input 
              type="text" 
              name="query" 
              placeholder="Search for products..." 
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
            >
            <button type="submit" class="absolute right-2 top-2 text-gray-500">
              <i class="fas fa-search"></i>
            </button>
          </div>
        </form>
      </div>
    </div>
    
    <!-- Categories Menu -->
    <div class="bg-gray-100 border-t border-b border-gray-200">
      <div class="container mx-auto px-4">
        <div class="flex items-center space-x-8 overflow-x-auto py-3 scrollbar-hide">
          <a href="/store" class="text-gray-600 hover:text-indigo-600 whitespace-nowrap">
            All Products
          </a>
          <a href="/store/categories" class="text-gray-600 hover:text-indigo-600 whitespace-nowrap">
            Categories
          </a>
          <a href="/store/merchants" class="text-gray-600 hover:text-indigo-600 whitespace-nowrap">
            Stores
          </a>
          <a href="/about" class="text-gray-600 hover:text-indigo-600 whitespace-nowrap">
            About Us
          </a>
          <a href="/contact" class="text-gray-600 hover:text-indigo-600 whitespace-nowrap">
            Contact
          </a>
        </div>
      </div>
    </div>
  </header>
  
  <!-- Flash Messages -->
  @if(flashMessages.has('success'))
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mt-4 mx-4" role="alert">
      <span class="block sm:inline">{{ flashMessages.get('success') }}</span>
      <span class="absolute top-0 bottom-0 right-0 px-4 py-3">
        <svg class="fill-current h-6 w-6 text-green-500" role="button" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
          <title>Close</title>
          <path d="M14.348 14.849a1.2 1.2 0 0 1-1.697 0L10 11.819l-2.651 3.029a1.2 1.2 0 1 1-1.697-1.697l2.758-3.15-2.759-3.152a1.2 1.2 0 1 1 1.697-1.697L10 8.183l2.651-3.031a1.2 1.2 0 1 1 1.697 1.697l-2.758 3.152 2.758 3.15a1.2 1.2 0 0 1 0 1.698z"/>
        </svg>
      </span>
    </div>
  @endif
  
  @if(flashMessages.has('error'))
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mt-4 mx-4" role="alert">
      <span class="block sm:inline">{{ flashMessages.get('error') }}</span>
      <span class="absolute top-0 bottom-0 right-0 px-4 py-3">
        <svg class="fill-current h-6 w-6 text-red-500" role="button" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
          <title>Close</title>
          <path d="M14.348 14.849a1.2 1.2 0 0 1-1.697 0L10 11.819l-2.651 3.029a1.2 1.2 0 1 1-1.697-1.697l2.758-3.15-2.759-3.152a1.2 1.2 0 1 1 1.697-1.697L10 8.183l2.651-3.031a1.2 1.2 0 1 1 1.697 1.697l-2.758 3.152 2.758 3.15a1.2 1.2 0 0 1 0 1.698z"/>
        </svg>
      </span>
    </div>
  @endif
  
  <!-- Main Content -->
  <main class="flex-grow container mx-auto px-4 py-8">
    @!section('content')
  </main>
  
  <!-- Footer -->
  <footer class="bg-gray-800 text-white py-12">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <!-- About -->
        <div>
          <h3 class="text-lg font-semibold mb-4">About MultiMarket</h3>
          <p class="text-gray-300 text-sm">
            MultiMarket is a multi-merchant e-commerce platform where vendors can sell their products and customers can shop from multiple stores in one place.
          </p>
        </div>
        
        <!-- Quick Links -->
        <div>
          <h3 class="text-lg font-semibold mb-4">Quick Links</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="/" class="text-gray-300 hover:text-white">Home</a></li>
            <li><a href="/store" class="text-gray-300 hover:text-white">Shop</a></li>
            <li><a href="/store/categories" class="text-gray-300 hover:text-white">Categories</a></li>
            <li><a href="/store/merchants" class="text-gray-300 hover:text-white">Stores</a></li>
          </ul>
        </div>
        
        <!-- Customer Service -->
        <div>
          <h3 class="text-lg font-semibold mb-4">Customer Service</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="/contact" class="text-gray-300 hover:text-white">Contact Us</a></li>
            <li><a href="/faq" class="text-gray-300 hover:text-white">FAQ</a></li>
            <li><a href="/terms" class="text-gray-300 hover:text-white">Terms & Conditions</a></li>
            <li><a href="/privacy" class="text-gray-300 hover:text-white">Privacy Policy</a></li>
          </ul>
        </div>
        
        <!-- Newsletter -->
        <div>
          <h3 class="text-lg font-semibold mb-4">Newsletter</h3>
          <p class="text-gray-300 text-sm mb-4">
            Subscribe to our newsletter for the latest updates and offers.
          </p>
          <form action="#" method="POST" class="flex">
            <input 
              type="email" 
              placeholder="Your email" 
              class="px-4 py-2 w-full text-gray-800 rounded-l-lg focus:outline-none"
            >
            <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 px-4 py-2 rounded-r-lg">
              <i class="fas fa-paper-plane"></i>
            </button>
          </form>
        </div>
      </div>
      
      <div class="border-t border-gray-700 mt-8 pt-8 flex flex-col md:flex-row justify-between items-center">
        <p class="text-gray-300 text-sm">
          &copy; {{ new Date().getFullYear() }} MultiMarket. All rights reserved.
        </p>
        
        <div class="flex space-x-4 mt-4 md:mt-0">
          <a href="#" class="text-gray-300 hover:text-white">
            <i class="fab fa-facebook-f"></i>
          </a>
          <a href="#" class="text-gray-300 hover:text-white">
            <i class="fab fa-twitter"></i>
          </a>
          <a href="#" class="text-gray-300 hover:text-white">
            <i class="fab fa-instagram"></i>
          </a>
          <a href="#" class="text-gray-300 hover:text-white">
            <i class="fab fa-linkedin-in"></i>
          </a>
        </div>
      </div>
    </div>
  </footer>
  
  @!section('scripts')
</body>
</html>

