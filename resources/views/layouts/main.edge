<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title || 'Multi-Merchant E-commerce' }}</title>
  
  @if(auth.isAuthenticated)
    <meta name="user-id" content="{{ auth.user.id }}">
    @if(auth.user.userType === 'merchant' && auth.user.merchant)
      <meta name="merchant-id" content="{{ auth.user.merchant.id }}">
    @end
    @if(auth.user.userType === 'admin')
      <meta name="is-admin" content="true">
    @end
  @end
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Alpine.js -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  
  <!-- Socket.io -->
  <script src="https://cdn.socket.io/4.6.0/socket.io.min.js"></script>
  
  <!-- Custom Styles -->
  <style>
    [x-cloak] { display: none !important; }
  </style>
  
  @!section('styles')
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">
  {{-- Include Header Partial --}}
  @include('../partials/header')
  
  {{-- Include Flash Messages Partial --}}
  @include('../partials/flash-messages')
  
  <!-- Main Content -->
  <main class="flex-grow container mx-auto px-4 py-8">
    @!section('content')
  </main>
  
  {{-- Include Footer Partial --}}
  @include('../partials/footer')
  
  @!section('scripts')
</body>
</html>
