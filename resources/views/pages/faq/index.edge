@section('scripts')
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Get all FAQ category buttons
    const btnAll = document.getElementById('btn-all');
    const btnGeneral = document.getElementById('btn-general');
    const btnCustomers = document.getElementById('btn-customers');
    const btnMerchants = document.getElementById('btn-merchants');
    const btnPayments = document.getElementById('btn-payments');
    
    // Get all FAQ sections
    const generalFaqs = document.getElementById('general-faqs');
    const customerFaqs = document.getElementById('customer-faqs');
    const merchantFaqs = document.getElementById('merchant-faqs');
    const paymentFaqs = document.getElementById('payment-faqs');
    
    // Function to reset all buttons
    function resetButtons() {
      [btnAll, btnGeneral, btnCustomers, btnMerchants, btnPayments].forEach(btn => {
        btn.classList.remove('bg-indigo-600', 'text-white');
        btn.classList.add('bg-gray-200', 'text-gray-800');
      });
    }
    
    // Function to show all sections
    function showAllSections() {
      [generalFaqs, customerFaqs, merchantFaqs, paymentFaqs].forEach(section => {
        section.style.display = 'block';
      });
    }
    
    // Event listeners for buttons
    btnAll.addEventListener('click', function() {
      resetButtons();
      this.classList.remove('bg-gray-200', 'text-gray-800');
      this.classList.add('bg-indigo-600', 'text-white');
      showAllSections();
    });
    
    btnGeneral.addEventListener('click', function() {
      resetButtons();
      this.classList.remove('bg-gray-200', 'text-gray-800');
      this.classList.add('bg-indigo-600', 'text-white');
      [generalFaqs, customerFaqs, merchantFaqs, paymentFaqs].forEach(section => {
        section.style.display = 'none';
      });
      generalFaqs.style.display = 'block';
    });
    
    btnCustomers.addEventListener('click', function() {
      resetButtons();
      this.classList.remove('bg-gray-200', 'text-gray-800');
      this.classList.add('bg-indigo-600', 'text-white');
      [generalFaqs, customerFaqs, merchantFaqs, paymentFaqs].forEach(section => {
        section.style.display = 'none';
      });
      customerFaqs.style.display = 'block';
    });
    
    btnMerchants.addEventListener('click', function() {
      resetButtons();
      this.classList.remove('bg-gray-200', 'text-gray-800');
      this.classList.add('bg-indigo-600', 'text-white');
      [generalFaqs, customerFaqs, merchantFaqs, paymentFaqs].forEach(section => {
        section.style.display = 'none';
      });
      merchantFaqs.style.display = 'block';
    });
    
    btnPayments.addEventListener('click', function() {
      resetButtons();
      this.classList.remove('bg-gray-200', 'text-gray-800');
      this.classList.add('bg-indigo-600', 'text-white');
      [generalFaqs, customerFaqs, merchantFaqs, paymentFaqs].forEach(section => {
        section.style.display = 'none';
      });
      paymentFaqs.style.display = 'block';
    });
  });
</script>
@end

